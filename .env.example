# API keys are optional. The local Ollama and built-in modes require no cloud keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AIDESKTOP_OPENAI_MODEL=gpt-4.1-mini
AIDESKTOP_ANTHROPIC_MODEL=claude-sonnet-4-5
AIDESKTOP_LOCAL_MODEL=qwen2.5:3b

# Default backend: Newelle GUI API on 127.0.0.1. Store its key with
# scripts/configure-newelle-key.sh, not in this file or version control.
AIDESKTOP_NEWELLE_PORT=8081
